<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 600 360" width="100%" height="100%">
  <defs>
    <linearGradient id="sufiNight" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" stop-color="#140152" />
      <stop offset="60%" stop-color="#02010a" />
      <stop offset="100%" stop-color="#22003b" />
    </linearGradient>
  </defs>
  <rect width="600" height="360" fill="url(#sufiNight)" />
  <circle cx="300" cy="180" r="130" fill="#ffd166" opacity="0.15" filter="blur(20px)" />
  <rect x="70" y="70" width="460" height="220" rx="16" fill="rgba(255, 255, 255, 0.05)" stroke="#e0a96d" stroke-width="1.5" />
  <text x="300" y="125" font-family="'Cinzel', serif" font-weight="700" font-size="12" fill="#e0a96d" text-anchor="middle" letter-spacing="4">KARACHI ARTS COUNCIL PRESENTS</text>
  <text x="300" y="185" font-family="'Playfair Display', Georgia, serif" font-weight="900" font-size="40" fill="#ffffff" text-anchor="middle">Qawwali Night</text>
  <text x="300" y="235" font-family="'Inter', sans-serif" font-weight="800" font-size="18" fill="#ffd166" text-anchor="middle" letter-spacing="3">WITH THE MALANGZ</text>
</svg>

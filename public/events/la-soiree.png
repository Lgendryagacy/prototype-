<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 600 360" width="100%" height="100%">
  <defs>
    <linearGradient id="luxuryDark" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#1b1b1b" />
      <stop offset="50%" stop-color="#2d2226" />
      <stop offset="100%" stop-color="#121212" />
    </linearGradient>
    <linearGradient id="roseGold" x1="0%" y1="0%" x2="100%" y2="0%">
      <stop offset="0%" stop-color="#f4acb7" />
      <stop offset="50%" stop-color="#ffcad4" />
      <stop offset="100%" stop-color="#d8e2dc" />
    </linearGradient>
  </defs>
  <rect width="600" height="360" fill="url(#luxuryDark)" />
  <!-- Card -->
  <rect x="70" y="60" width="460" height="240" rx="16" fill="rgba(255, 255, 255, 0.04)" stroke="url(#roseGold)" stroke-width="1.5" />
  <text x="300" y="115" font-family="'Inter', sans-serif" font-weight="600" font-size="11" fill="#f4acb7" text-anchor="middle" letter-spacing="4">EXCLUSIVE LAHORE EXHIBITION</text>
  <text x="300" y="175" font-family="'Playfair Display', Georgia, serif" font-weight="900" font-size="44" fill="#ffffff" text-anchor="middle">La Soirée</text>
  <text x="300" y="225" font-family="'Montserrat', sans-serif" font-weight="700" font-size="15" fill="url(#roseGold)" text-anchor="middle" letter-spacing="4">FASHION &amp; LIFESTYLE</text>
  <text x="300" y="260" font-family="'Inter', sans-serif" font-weight="500" font-size="11" fill="#b7b7a4" text-anchor="middle">High Fashion · Luxury Designers · Curated Boutiques</text>
</svg>
